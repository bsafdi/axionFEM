    "E_z": 0.0
   },
   "Ha": [
    0.0,
    10.0,
    100.0,
    1000.0
   ],
   "boundaries": {
    "velocity": "Dirichlet u = 0 on all walls",
    "potential": "insulating on all walls (potential up to a constant)"
   },
   "probes": {
    "center": [
     0.0,
     0.0
    ],
    "side": [
     [
      1.0,
      0.0
     ],
