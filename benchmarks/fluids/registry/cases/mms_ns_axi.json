{
 "id": "mms_ns_axi",
 "capability": "F2a",
 "title": "Axisymmetric NS MMS with swirl: parity-respecting, variable mu, both viscous and both convective forms; r-weighted and unweighted norms; structured and distorted nested meshes",
 "physics": "cylindrical (u_r, u_theta, u_z, p)(r, z); rho G u - div sigma_form = f with centrifugal -rho u_theta^2 / r and Coriolis rho u_r u_theta / r; Dirichlet on r = 1, z = 0, z = 1; axis r = 0",
 "levels": [
  "mms",
  "conservation"
 ],
 "run": {
  "runner": {
   "module": "f2a_ns",
   "function": "mms_axi",
   "check_module": "f2a_ns_check",
   "cost": "long",
   "timeout_s": 7200
  },
  "parameters": {
   "element": {
    "velocity": "P2",
    "pressure": "P1",
    "geometry": "affine (straight-sided)"
   },
   "viscous_forms": [
    "lap",
    "sym"
   ],
   "convective_forms": [
    "standard",
    "skew"
   ],
   "convective_form_definitions": {
    "standard": "c(w; u, v) = rho ((w. grad) u, v)",
    "skew": "c(w; u, v) = rho ((w. grad) u, v) + (rho/2) ((div w) u, v) (Temam; natural BC unchanged: a traction BC prescribes sigma_form n = g for both forms)"
   },
   "quadrature_error_norms": 10,
   "quadrature_requirement": "The convective trilinear form and every load integral must be integrated EXACTLY for the polynomial integrands of P2 on affine triangles: degree >= 5 planar (P2. grad P2. P2), degree >= 6 in axisymmetry (the extra factor r); the viscous form with variable mu by a rule of degree >= 4 planar (as F1a) and, in AXISYMMETRY, the r-weighted viscous form (with its rational hoop terms mu u_r v_r / r, mu u_theta v_theta / r) by a rule of degree >= 6 (with degree 4 a correct code's energy-identity defect reaches 9.1e-10, with degree 6 <= 2.4e-11). The discrete energy identities (cons_ns_energy_identity) and the cross-code values (xcode_cavity_re1000) assume it.",
   "nonlinear_solver": {
    "start": "the TRUE Stokes solution with the Dirichlet data (the convective term absent from both the matrix and the residual of that first step: Oseen with zero advecting velocity), then n_picard = 3 Picard (Oseen) steps, then Newton with an Armijo backtracking line search on the DUAL-norm merit ||R||_* (sufficient decrease 1e-4; lambda = 1, 1/2,..., 1/64; lambda = 1/64 is accepted even without sufficient decrease and then counts as a violation in the line-search check)",
    "newton_rtol": 1e-12,
    "newton_maxit": 30,
    "residual_definition": "relative_residual = ||R(x)||_* / ||R(x_lift)||_*, the discrete dual norm over the rows of the system actually solved (a pinned pressure row excluded), with consistent exactly integrated mass matrices, and x_lift the P2 Lagrange NODAL lift (the Dirichlet data at the boundary nodes, vertices and edge midpoints, ZERO at every other node, p = 0): with that definite lift the same number in every basis of the same spaces (zeroing the interior coefficients of a hierarchical basis gives another lift and a denominator smaller by 1.8-1.9)",
    "linear_solver": "direct sparse LU",
    "history": "every run reports solver.history = [{kind: stokes|picard|newton|ptc, residual, step, dt}] with the relative residual after each step"
   },
   "shared_node_rule": "At a velocity node shared by several boundary attributes: (1) Dirichlet beats every natural condition (traction); (2) between Dirichlet attributes the fixed data AGREE at shared nodes (one exact callable per field; checked by dirichlet_shared_node_mismatch_max), so the result is independent of attribute order; (3) AXISYMMETRIC: at a node on the axis r = 0 the axis condition u_r = u_theta = 0 holds and beats the data (the exact data have the same limit; the numpy spelling of the data is not evaluated at r = 0 for u_r, u_theta); u_z takes the data.",
   "dirichlet_data": "P2 Lagrange NODAL interpolation of the fixed callables (vertices and edge midpoints)",
   "mms_data": {
    "path": "tools/fluids_mms/out/ns_axi_dirichlet.json",
    "sha256": "a0be27b37708ff4138e6e9305f376ac5c4229a02f9dedcb84f33303a3f1d44a9"
   },
   "rho": 1.25,
   "coordinates": "(r, z) in [0,1]^2; the edge r = 0 is the axis",
   "meshes": {
    "structured": {
     "family": "structured",
     "N": [
      8,
      16,
      32,
      64,
      128
     ],
     "h_nominal": [
      0.125,
      0.0625,
      0.03125,
      0.015625,
      0.0078125
     ],
     "construction": "f1a_stokes_check.structured_mesh(N) on [0,1]^2 in (r, z): the N = 8 BASE mesh (8 x 8 squares split along the (1,1) diagonal, except the two cells at the corners (1,0) and (0,1), split the other way: no triangle with all vertices on the boundary) refined uniformly (red) log2(N/8) times. Nested; verify_mesh checks counts, hash, nesting.",
     "h_definition": "h_nominal = 1/N (leg of the right triangles); h_max = sqrt(2)/N reported too"
    },
    "distorted": {
     "family": "distorted",
     "N0": 4,
     "refinements": [
      1,
      2,
      3,
      4,
      5
     ],
     "h_nominal": [
      0.125,
      0.0625,
      0.03125,
      0.015625,
      0.0078125
     ],
     "perturb_rel": 0.2,
     "seed": 20261031,
     "construction": "f2a_ns_check.distorted_unit(k) = f1a_stokes_check.distorted_mesh(k) on [0,1]^2 in (r, z): structured N0 = 4 base mesh, interior vertices displaced by 0.2 (1/4) U(-1,1)^2 (PCG64(20261031)), then k red refinements (nested; Jacobians vary element to element).",
     "h_definition": "h_nominal = 0.25 / 2^k"
    }
   },
   "boundaries": {
    "axis": "u_r = u_theta = 0 strongly; u_z and p natural",
    "r1|z0|z1": "Dirichlet (u_r, u_theta, u_z) from the field"
   },
   "weak_form": "every volume integral carries the weight r (dV / 2 pi = r dr dz); continuity tested with r q (symmetric saddle point); with the hoop terms of the axisymmetric strain",
   "pressure": "no constraint given: constant-pressure nullspace",
   "newton_check": {
    "N": 32,
    "start": "Stokes solution, no Picard steps",
    "line_search": "OFF",
    "forms": [
     [
      "lap",
      "standard"
     ],
     [
      "sym",
      "standard"
     ],
     [
      "lap",
      "skew"
     ],
     [
      "sym",
      "skew"
     ]
    ]
   }
  }
 },
