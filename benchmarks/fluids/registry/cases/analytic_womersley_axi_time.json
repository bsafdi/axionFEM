      "newton"
     ],
     [
      2,
      "newton"
     ],
     [
      2,
      "semi"
     ]
    ]
   },
   "dt_levels": [
    0.05,
    0.025,
    0.0125,
    0.00625,
    0.003125
   ],
   "boundaries": "wall r = 1 no-slip; axis conditions; z = 0 and z = 1 traction sigma_form n = g(t)",
   "initial_data": "the exact state at t = 0, projected (TIME_SCHEME.initial_data)",
   "pressure": "determined by the traction boundaries (compared raw)"
  }
 },
