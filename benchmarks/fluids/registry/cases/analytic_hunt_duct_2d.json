{
 "id": "analytic_hunt_duct_2d",
 "capability": "F13a",
 "title": "Hunt duct (perfectly conducting Hartmann walls, insulating side walls; side-layer jets), Ha 10-1000: series reference; two independent current computations; conservation",
 "physics": "Fully developed square-duct flow w(x, y) e_z driven by G_z, B = (0, B0, 0), 2.5D inductionless",
 "levels": [
  "analytic",
  "conservation"
 ],
 "run": {
  "runner": {
   "module": "f13a_mhd",
   "function": "hunt_duct",
   "check_module": "f13a_mhd_check",
   "cost": "long",
   "timeout_s": 7200
  },
  "parameters": {
   "formulation": "2.5D planar inductionless MHD (u = (u_x, u_y, u_z) independent of z; J = sigma(-grad phi + E_z e_z + u x B); Lorentz force J x B; conservative potential equation (J, grad psi) = <j_n, psi> - (q, psi))",
   "element": {
    "velocity": "P2 (all three components)",
    "pressure": "P1",
    "potential": "P2 Lagrange",
    "geometry": "affine (straight-sided)"
   },
   "viscous_form": "lap (mu constant: both forms coincide with Dirichlet data)",
   "quadrature_error_norms": 10,
   "dirichlet_data": "P2 Lagrange NODAL interpolation of the fixed callables (velocity and potential)",
   "solver": {
    "kind": "direct sparse LU (Newton for rho > 0)",
    "tight": "same, plus 2 steps of iterative refinement / Newton to 1e-14 (vacuous for a direct linear solve; meaningful for an iterative path)"
   },
   "shared_node_rule": "At a node shared by several boundary attributes: (1) velocity Dirichlet beats every natural velocity condition; potential Dirichlet beats insulation and normal-current data; (2) between Dirichlet attributes the fixed data AGREE at shared nodes (one exact callable per MMS field; the Hartmann/duct data vanish or are consistent at the corners), checked by dirichlet_shared_node_mismatch, so the result is independent of attribute order.",
   "series_magnitude_keys": {
    "uL2": "u_magnitude",
    "uH1": "u_magnitude",
    "divL2": "u_magnitude",
    "pL2": "p_magnitude",
    "phiL2": "phi_magnitude",
    "phiH1": "phi_magnitude",
    "JL2": "J_magnitude"
   },
   "meshes": {
    "duct": {
     "family": "duct_Ha<Ha>",
     "Ha": [
      10.0,
      100.0,
      1000.0
     ],
     "k": [
      0,
      1,
      2,
      3
     ],
     "h_nominal": [
      0.0625,
      0.03125,
      0.015625,
      0.0078125
     ],
     "construction": "f13a_mhd_check.duct_mesh(Ha, k): base 16 x 16 cells on [-1, 1]^2, y nodes graded_nodes(16, 1, 1/Ha) (first interval = Hartmann-layer thickness), x nodes graded_nodes(16, 1, 1/sqrt(Ha)) (side layers); uniform for Ha = 0; corner cells flipped (Taylor-Hood condition); k red refinements (NESTED: the grading is fixed by the base mesh)",
     "h_definition": "h_nominal = 1/(16 * 2^k) (computational, base intervals halved per refinement); h_max reported"
    }
   },
   "physical": {
    "mu": 0.5,
    "sigma": 2.0,
    "G_z": 1.0,
    "a": 1.0,
    "L": 1.0,
    "B": "(0, B0, 0), B0 = Ha/2",
    "E_z": 0.0
   },
   "Ha": [
    10.0,
    100.0,
    1000.0
   ],
   "boundaries": {
    "velocity": "Dirichlet u = 0 on all walls",
    "potential": "potential Dirichlet phi = 0 on the Hartmann walls y = +-1; insulating side walls x = +-1"
   },
   "probes": {
    "center": [
     0.0,
     0.0
    ],
    "side": [
     [
      1.0,
      0.0
     ],
     [
      -1.0,
      0.0
     ]
    ]
   },
   "scaling_identity": {
    "Ha": 100.0,
    "k": 1,
    "pair": "(sigma, B0) and (4 sigma, B0/2)"
   },
   "core": {
    "half_widths": [
     0.5,
     0.5
    ],
    "quadrature_degree": 6,
    "exact_J": "f13a_mhd_check.core_J_exact('hunt', mu, sigma, B0, G) (fixed with the check module)"
   },
   "identities_at_Ha0": "every identity returns 0 when J_h = 0 identically (B = 0); the Ha = 0 rows enter only the power balance and the axial-momentum identity",
   "identity_definitions": "f13a_mhd_check: cancelling-term normalization"
  }
 },
