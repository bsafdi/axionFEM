     ],
     "construction": "f1c_stokes_check.cube_tet(N): N^3 cells, each split into the 6 Kuhn tetrahedra, the Kuhn diagonal of each octant reflected towards that octant's corner of the cube (every tetrahedron has an interior vertex); the level-N mesh IS the Bey red refinement of the level-N/2 mesh (nested; checked by the self-tests)",
     "h_definition": "h_nominal = 1/N (cell edge); h_max = sqrt(3)/N reported"
    },
    "hex": {
     "family": "hex",
     "N": [
      4,
      8,
      16,
      32
     ],
     "h_nominal": [
      0.25,
      0.125,
      0.0625,
      0.03125
     ],
     "construction": "f1c_stokes_check.cube_hex(N): N^3 axis-aligned hexahedra (Q2/Q1), vertices in lexicographic (basix) order",
     "h_definition": "h_nominal = 1/N"
    }
   },
   "traction_faces": {
    "x1": [
     1,
     0,
     0
    ],
    "y1": [
     0,
     1,
     0
    ],
    "z1": [
     0,
     0,
     1
    ]
   },
   "traction_data": "g = f1c_stokes_check.Field.traction(form, x, n): the fixed sigma_form of the field, evaluated at the solver's boundary quadrature points (a vector; the solver never computes a normal for it)",
   "shared_node_rule": "At a velocity node shared by several boundary attributes (edges and corners of the cube, the slip-symmetry edge of T4): (1) Dirichlet beats every natural condition and every slip/symmetry constraint; (2) between Dirichlet attributes the fixed data AGREE (one exact callable per field; checked: dirichlet_shared_node_mismatch_max), so no precedence is needed and the result is independent of attribute order; (3) at a node on two slip/symmetry faces BOTH normal constraints are imposed (u along the common edge only); (4) no periodic boundaries in F1c.",
   "boundary_faces": {
    "dirichlet": [
     "x0",
     "y0",
     "z0"
    ],
    "traction": [
     "x1",
     "y1",
     "z1"
    ],
    "predicate": "a node lies on a face iff its coordinate equals the face value to 1e-12 (|r - R| < 1e-9 for the spheres)"
   }
  }
