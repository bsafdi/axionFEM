    "lap_dn": "lap, inflow Dirichlet parabola, outlet do-nothing, walls no-slip",
    "sym_tr": "sym, inflow Dirichlet, outlet traction (0, mu U'(y)) (exact)",
    "lap_pd / sym_pd": "inlet and outlet traction -p n (+ (0, -/+ mu U') for sym), pressure-driven",
    "lap_half": "lap, half channel, symmetry on y = 1/2, outlet do-nothing",
    "lap_per_dp / sym_per_dp": "periodic in x (period 2), pressure drop 4 per period prescribed",
    "lap_per_q / sym_per_q": "periodic, flow rate Q = G H^3/(12 mu) = 1/6 prescribed; G_h computed",
    "lap_pin": "all Dirichlet (parabola at both ends), pressure point at (1, 1/2) with p = 2",
    "plug_lap / plug_sym": "plug flow in the channel rotated by 30 deg, slip walls",
    "control_sym_dn": "sym, inflow Dirichlet, outlet do-nothing: NOT Poiseuille (positive control)"
   },
   "shared_node_rule": "At a velocity node shared by several boundary attributes: (1) Dirichlet beats every natural condition (traction, do-nothing) and every slip/symmetry constraint (the slip constraint is not imposed at such nodes); (2) between Dirichlet attributes the fixed data AGREE at shared nodes (checked: dirichlet_shared_node_mismatch_max), so no precedence between them is needed and the result is independent of attribute order; (3) between two slip/symmetry attributes both normal constraints are imposed (u = 0 at a convex corner); (4) a periodic pair at a Dirichlet corner takes the (periodic-consistent) Dirichlet value."
  }
