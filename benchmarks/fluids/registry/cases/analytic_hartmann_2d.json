     },
     "velocity": "as inplane_short",
     "potential": "insulating everywhere"
    },
    "duct_open": {
     "Ha": [
      10.0,
      100.0
     ],
     "G_z": 1.0,
     "velocity": "Dirichlet: 0 on y = +-1, (0, 0, W(y)) on x = 0 and x = LX (exact, nodal)",
     "potential": {
      "x0": 0.0,
      "x1": {
       "Ha10": -0.2250000010305768,
       "Ha100": -0.24749999999999978
      },
      "y0 y1": "insulating"
     }
    },
    "duct_jn": {
     "Ha": [
      10.0,
      100.0
     ],
     "G_z": 1.0,
     "velocity": "as duct_open",
     "potential": {
      "x0": "normal current density j_n = -sigma(E_x - B0 W(y)) (outward n = -e_x)",
      "x1": "normal current density j_n = +sigma(E_x - B0 W(y)) (outward n = +e_x)",
      "y0 y1": "insulating",
      "E_x": "as duct_open (open circuit)",
      "gauge": "nullspace: compared mean-free"
