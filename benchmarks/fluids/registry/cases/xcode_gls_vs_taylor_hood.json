{
 "id": "xcode_gls_vs_taylor_hood",
 "capability": "F5",
 "title": "Agreement with the F2a Taylor-Hood solution: regularized-lid cavity at Re = 100 and 1000, P1/P1 GLS on N = 32, 64, 128",
 "physics": "smooth (regularized-lid) cavity: the stabilized P1/P1 solution converges at second order to the Taylor-Hood solution",
 "levels": [
  "cross_code"
 ],
