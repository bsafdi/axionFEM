   "traction_variant": {
    "name": "S1T",
    "inner": "u = 0 (body condition) on r = 1",
    "outer": "g = sigma_form(exact unbounded field)(x) x/|x| on r = 4 (vector data; the solver never needs a normal); pressure determined (raw pL2), nullspace_detected = 0",
    "forms": [
     "sym",
     "lap"
    ]
   },
   "quadrature_assumed": "viscous, divergence and grad-div rules exact to degree >= 4 on curved P2 tetrahedra and >= 3^3 Gauss on Q2 hexahedra (2^3 Gauss on curved Q2 has hourglass modes)",
   "drag": "f1c_stokes_check.drag_sums (Babuska-Miller volume residual with the P2/Q2 test function equal to e_z at the sphere nodes, sym form) from the solution; the API's sol.reaction is reported alongside",
   "shared_node_rule": "At a velocity node shared by several boundary attributes (edges and corners of the cube, the slip-symmetry edge of T4): (1) Dirichlet beats every natural condition and every slip/symmetry constraint; (2) between Dirichlet attributes the fixed data AGREE (one exact callable per field; checked: dirichlet_shared_node_mismatch_max), so no precedence is needed and the result is independent of attribute order; (3) at a node on two slip/symmetry faces BOTH normal constraints are imposed (u along the common edge only); (4) no periodic boundaries in F1c.",
   "boundary_faces": {
    "body": "r = 1",
    "outer": "r = 4",
    "predicate": "a node lies on a face iff its coordinate equals the face value to 1e-12 (|r - R| < 1e-9 for the spheres)"
   }
  }
