{
 "id": "mms_gls_ns_2d",
 "capability": "F5",
 "title": "Stabilized P1/P1 Oseen and Navier-Stokes MMS (planar): diffusive, mixed and convection-dominated regimes (tau pinned in both limits)",
 "physics": "steady Navier-Stokes / Oseen with the non-Beltrami MMS of F2a at three viscosity scales (element Peclet from 0.2 to 4.6), SUPG + PSPG + LSIC, both viscous forms, variable mu",
 "levels": [
  "mms",
  "conservation"
 ],
 "run": {
  "runner": {
   "module": "f5_gls",
   "function": "mms_ns",
   "check_module": "f5_gls_check",
   "cost": "long",
   "timeout_s": 10800
  },
  "parameters": {
   "element": {
    "velocity": "P1",
    "pressure": "P1",
    "geometry": "affine (straight-sided)"
   },
   "formulation": "Equal-order continuous P1/P1 (u, p) on affine triangles, nodal basis, constant density rho, viscosity mu(x) (analytic with gradient, or a P1 nodal field with its element-wise gradient). Residual R_u,a = sum_K int [ rho (u_t + (w.grad)u).N_a e_i + a_visc(mu;u)(N_a e_i) - p d_i N_a - f_i N_a + tau_supg rho ((w.grad N_a) R_i) + tau_c rho (div u) d_i N_a ], R_p,a = sum_K int [ (div u) N_a + (tau_pspg/rho) grad N_a. R ] with the strong residual R = rho (u_t + (w.grad)u) + grad p - div sigma_visc(u; mu) - f (second derivatives of a P1 u vanish; grad mu KEPT: lap: sum_j d_j mu d_j u_i, sym: sum_j d_j mu (d_j u_i + d_i u_j)), w = u (Navier-Stokes), a given field (Oseen) or 0 (Stokes: convective and SUPG terms absent); a_visc lap = mu grad u : grad v, sym = mu (grad u + grad u^T) : grad v; BDF1 u_t = (u - u^{n-1})/dt or BDF2 (3u - 4u^{n-1} + u^{n-2})/(2 dt), constant step; tau_supg = [ (2/dt)^2 + CG w.G w + C_I (mu/rho)^2 G:G ]^(-1/2), tau_pspg = [ CG w.G w + C_I (mu/rho)^2 G:G ]^(-1/2) (NO dt term), tau_c = 1/(tau_pspg tr G), G_ij = sum_k dz_k/dx_i dz_k/dx_j with z the coordinates of the EQUILATERAL reference triangle of edge 1 (invariant under vertex renumbering), C_I = 36, CG = 1 (the (2/dt)^2 term only when dt is given). Every element integral by the pinned 6-point degree-4 rule f5_gls_check.rule_points() (the Galerkin terms of P1 data are polynomials of degree <= 3; tau is not polynomial). The continuity row carries the POSITIVE sign (div u) q. The Newton Jacobian is the exact derivative of this residual INCLUDING d tau / d state. Reference implementation: f5_gls_check.residual (numpy), agreeing with the independent NGSolve assembly to 3e-16.",
   "stabilization": {
    "family": "GLS-type residual-based: SUPG + PSPG + LSIC",
    "tau": "Shakib-type, from the element metric tensor G (docs/guides/fluids.md, stabilized equal-order elements)",
    "C_I": 36.0,
    "CG": 1.0,
    "quadrature": "6-point degree-4 rule, f5_gls_check.rule_points()"
   },
   "quadrature_error_norms": 10,
   "nonlinear_solver": {
    "start": "Stokes solution (GLS-stabilized, w = 0) with the Dirichlet data, then Newton with the exact Jacobian (d tau included) and an Armijo backtracking line search on the dual-norm merit (sufficient decrease 1e-4, lambda = 1, 1/2,..., 1/64); a continuation in the viscosity (or Re) is allowed: whatever path is used, the solution is that of the steady discrete equations",
    "newton_rtol": 1e-12,
    "newton_maxit": 40,
    "linear_solver": "direct sparse LU",
    "history": "solver.history = [{kind, residual, step}] with the relative residual after each step"
   },
   "dirichlet_data": "P1 nodal interpolation of the fixed callables at the boundary vertices",
   "mms_data": {
    "gls_sq_diff": {
     "path": "tools/fluids_mms/out/gls_sq_diff.json",
     "sha256": "ab920a533feaf37666ca05efdd8dcd47bfcd370bd090a33795f9bd627f5b97cd"
    },
    "gls_sq_mix": {
     "path": "tools/fluids_mms/out/gls_sq_mix.json",
     "sha256": "0000e2a6991e4d7df009603b8f685667efe6223b9da2a05502648013830c97b8"
    },
    "gls_sq_conv": {
     "path": "tools/fluids_mms/out/gls_sq_conv.json",
     "sha256": "de568e0bb964312c6db04b5c51d100f374105e89ce3521a99d454e7476e5ca17"
    }
   },
   "rho": 1.25,
   "regimes": {
    "diff": "mu x 10",
    "mix": "mu",
    "conv": "mu / 40"
   },
   "meshes": {
    "structured": {
     "family": "structured",
     "N": [
      8,
      16,
      32,
      64,
      128
     ],
     "h_nominal": [
      0.125,
      0.0625,
      0.03125,
      0.015625,
      0.0078125
     ],
     "construction": "f1a_stokes_check.structured_mesh(N) on [0,1]^2: the N = 8 BASE mesh (8 x 8 squares split along the (1,1) diagonal, except the two cells at the corners (1,0) and (0,1), split the other way) refined uniformly (red) log2(N/8) times. Nested; verify_mesh checks counts, hash, nesting.",
     "h_definition": "h_nominal = 1/N (leg of the right triangles)"
    },
    "distorted": {
     "family": "distorted",
     "N0": 4,
     "refinements": [
      1,
      2,
      3,
      4,
      5
     ],
     "h_nominal": [
      0.125,
      0.0625,
      0.03125,
      0.015625,
      0.0078125
     ],
     "perturb_rel": 0.2,
     "seed": 20261031,
     "construction": "f2a_ns_check.distorted_unit(k) = f1a_stokes_check.distorted_mesh(k) on [0,1]^2: structured N0 = 4 base mesh, interior vertices displaced by 0.2 (1/4) U(-1,1)^2 (PCG64(20261031)), then k red refinements.",
     "h_definition": "h_nominal = 0.25 / 2^k"
    }
   },
   "oseen": "advecting velocity = the exact field (fixed callable at the quadrature points); the problem is linear",
   "continuation": "the convective regime needs a viscosity continuation from mu x 200 (for example 200, 80, 30, 12, 5, 2, 1); any path is allowed"
  }
