# Build provenance for axionfem._core.build_info() and libaxionfem: the git commit of the source tree, and whether the
# tree differed from it when the build ran. Run by the custom target axf_gitinfo on EVERY build (not only when CMake
# configures), so a rebuild after a commit or an edit reports the new state without re-running CMake; the header is
# rewritten only when its content changes, so an unchanged tree recompiles nothing.
#   cmake -DSRC_DIR=<source dir> -DOUT=<header path> -P axf_gitinfo.cmake
# One `git status` over the source paths gives both dirty flags:
#   AXF_BUILD_GIT_DIRTY / _FILES: tracked changes or untracked files under the compiled paths (cpp/, cmake/,
#     CMakeLists.txt), up to 10 of them named;
#   AXF_BUILD_SOURCE_DIRTY: the same over those paths plus python/, benchmarks/ and tests/ ("true", "false", or
#     "unknown" without git).
# Paths are relative to the source tree; nothing absolute is written. Outside a git checkout (a source archive) the
# sha is "unknown" and the compiled sources count as dirty.
find_program(_axf_git git)
set(_sha "unknown")
set(_dirty 1)
set(_files "")
set(_source_dirty "unknown")
if(_axf_git)
  # the source tree must be the top of its own checkout: a source archive unpacked inside another repository is not
  # that repository's commit
  execute_process(COMMAND ${_axf_git} rev-parse --show-toplevel WORKING_DIRECTORY ${SRC_DIR}
                  OUTPUT_VARIABLE _top RESULT_VARIABLE _rc0 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  get_filename_component(_top "${_top}" REALPATH)
  get_filename_component(_src "${SRC_DIR}" REALPATH)
  set(_out "")
  set(_rc 1)
  if(_rc0 EQUAL 0 AND _top STREQUAL _src)
    execute_process(COMMAND ${_axf_git} rev-parse HEAD WORKING_DIRECTORY ${SRC_DIR}
                    OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  if(_rc EQUAL 0 AND _out MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]+$")
    set(_sha "${_out}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E env GIT_OPTIONAL_LOCKS=0
                            ${_axf_git} status --porcelain --untracked-files=all --
                            cpp cmake CMakeLists.txt python benchmarks tests
                    WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE _st RESULT_VARIABLE _rc2
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc2 EQUAL 0)
      set(_dirty 0)
      set(_source_dirty "false")
      if(NOT _st STREQUAL "")
        set(_source_dirty "true")
        string(REPLACE ";" "," _st "${_st}")   # a list separator in a file name must not split the entry
        string(REPLACE "\n" ";" _st "${_st}")
        set(_compiled "")
        foreach(_line IN LISTS _st)
          # porcelain v1: two status characters, a space, the path; a rename or copy (R or C in either column) is
          # "old -> new", and either side in the compiled paths counts (a file moved out of cpp/ changes it too)
          string(SUBSTRING "${_line}" 0 2 _xy)
          string(SUBSTRING "${_line}" 3 -1 _paths)
          if(_xy MATCHES "[RC]")
            string(REGEX REPLACE "^(.*) -> (.*)$" "\\1;\\2" _paths "${_paths}")
          endif()
          set(_hit FALSE)
          foreach(_path IN LISTS _paths)
            string(REGEX REPLACE "^\"" "" _path "${_path}")
            if(_path MATCHES "^(cpp/|cmake/|CMakeLists\\.txt$)")
              set(_hit TRUE)
            endif()
          endforeach()
          if(_hit)
            list(APPEND _compiled "${_line}")
          endif()
        endforeach()
        list(LENGTH _compiled _n)
        if(_n GREATER 0)
          set(_dirty 1)
          if(_n GREATER 10)
            list(SUBLIST _compiled 0 10 _compiled)
          endif()
          string(REPLACE ";" " | " _files "${_compiled}")
          string(REPLACE "\"" "'" _files "${_files}")
          string(REPLACE "\\" "/" _files "${_files}")
        endif()
      endif()
    endif()
  endif()
endif()
set(_content "// Generated by cmake/axf_gitinfo.cmake on every build; do not edit.\n#pragma once\n#define AXF_BUILD_GIT_SHA \"${_sha}\"\n#define AXF_BUILD_GIT_DIRTY ${_dirty}\n#define AXF_BUILD_GIT_DIRTY_FILES \"${_files}\"\n#define AXF_BUILD_SOURCE_DIRTY \"${_source_dirty}\"\n")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT}" "${_content}")
endif()
