{
 "name": "annulus_lap",
 "description": "Curved free-slip wall: annulus 1<r<2, inner cylinder rotating at Omega=1, outer free slip. The two forms have DIFFERENT exact solutions (sym: rigid rotation; lap: A r + B/r). Needs isoparametric P2 geometry (Babuska-paradox control).",
 "domain": {
  "kind": "annulus",
  "r": [
   1,
   2
  ]
 },
 "pressure": "mean_zero",
 "conventions": {
  "G_ij": "d u_i / d x_j",
  "sigma_sym": "2 mu eps(u) - p I",
  "sigma_lap": "mu G - p I",
  "f": "-div sigma_form - gamma grad div u (= -div sigma_form for these fields)",
  "traction": "g = sigma_form n, n the outward unit normal",
  "grad_div": "gamma (div u_h, div v); gamma in viscosity units, not scaled by mu"
 },
 "u": [
  {
   "sympy": "-y*(1/5 + 4/(5*(x**2 + y**2)))",
   "c": "-y*(1.0/5.0 + (4.0/5.0)/(pow(x, 2) + pow(y, 2)))",
   "numpy": "-y*(1/5 + (4/5)/(x**2 + y**2))"
  },
  {
   "sympy": "x*(1/5 + 4/(5*(x**2 + y**2)))",
   "c": "x*(1.0/5.0 + (4.0/5.0)/(pow(x, 2) + pow(y, 2)))",
   "numpy": "x*(1/5 + (4/5)/(x**2 + y**2))"
  }
 ],
 "p": {
  "sympy": "0",
  "c": "0",
  "numpy": "0"
 },
 "mu": {
  "sympy": "1",
  "c": "1",
  "numpy": "1"
 },
 "grad_u": [
  [
   {
    "sympy": "8*x*y/(5*(x**2 + y**2)**2)",
    "c": "(8.0/5.0)*x*y/pow(pow(x, 2) + pow(y, 2), 2)",
    "numpy": "(8/5)*x*y/(x**2 + y**2)**2"
   },
   {
    "sympy": "8*y**2/(5*(x**2 + y**2)**2) - 1/5 - 4/(5*(x**2 + y**2))",
    "c": "(8.0/5.0)*pow(y, 2)/pow(pow(x, 2) + pow(y, 2), 2) - 1.0/5.0 - (4.0/5.0)/(pow(x, 2) + pow(y, 2))",
    "numpy": "(8/5)*y**2/(x**2 + y**2)**2 - 1/5 - (4/5)/(x**2 + y**2)"
   }
  ],
  [
   {
    "sympy": "-8*x**2/(5*(x**2 + y**2)**2) + 1/5 + 4/(5*(x**2 + y**2))",
    "c": "-8.0/5.0*pow(x, 2)/pow(pow(x, 2) + pow(y, 2), 2) + 1.0/5.0 + (4.0/5.0)/(pow(x, 2) + pow(y, 2))",
    "numpy": "-8/5*x**2/(x**2 + y**2)**2 + 1/5 + (4/5)/(x**2 + y**2)"
   },
   {
    "sympy": "-8*x*y/(5*(x**2 + y**2)**2)",
    "c": "-8.0/5.0*x*y/pow(pow(x, 2) + pow(y, 2), 2)",
    "numpy": "-8/5*x*y/(x**2 + y**2)**2"
   }
  ]
 ],
 "forms": {
  "lap": {
   "f": [
    {
     "sympy": "32*x**2*y/(5*(x**2 + y**2)**3) + 32*y**3/(5*(x**2 + y**2)**3) - 32*y/(5*(x**2 + y**2)**2)",
     "c": "(32.0/5.0)*pow(x, 2)*y/pow(pow(x, 2) + pow(y, 2), 3) + (32.0/5.0)*pow(y, 3)/pow(pow(x, 2) + pow(y, 2), 3) - 32.0/5.0*y/pow(pow(x, 2) + pow(y, 2), 2)",
     "numpy": "(32/5)*x**2*y/(x**2 + y**2)**3 + (32/5)*y**3/(x**2 + y**2)**3 - 32/5*y/(x**2 + y**2)**2"
    },
    {
     "sympy": "-32*x**3/(5*(x**2 + y**2)**3) - 32*x*y**2/(5*(x**2 + y**2)**3) + 32*x/(5*(x**2 + y**2)**2)",
     "c": "-32.0/5.0*pow(x, 3)/pow(pow(x, 2) + pow(y, 2), 3) - 32.0/5.0*x*pow(y, 2)/pow(pow(x, 2) + pow(y, 2), 3) + (32.0/5.0)*x/pow(pow(x, 2) + pow(y, 2), 2)",
     "numpy": "-32/5*x**3/(x**2 + y**2)**3 - 32/5*x*y**2/(x**2 + y**2)**3 + (32/5)*x/(x**2 + y**2)**2"
    }
   ],
   "sigma": [
    [
     {
      "sympy": "8*x*y/(5*(x**2 + y**2)**2)",
      "c": "(8.0/5.0)*x*y/pow(pow(x, 2) + pow(y, 2), 2)",
      "numpy": "(8/5)*x*y/(x**2 + y**2)**2"
     },
     {
      "sympy": "8*y**2/(5*(x**2 + y**2)**2) - 1/5 - 4/(5*(x**2 + y**2))",
      "c": "(8.0/5.0)*pow(y, 2)/pow(pow(x, 2) + pow(y, 2), 2) - 1.0/5.0 - (4.0/5.0)/(pow(x, 2) + pow(y, 2))",
      "numpy": "(8/5)*y**2/(x**2 + y**2)**2 - 1/5 - (4/5)/(x**2 + y**2)"
     }
    ],
    [
     {
      "sympy": "-8*x**2/(5*(x**2 + y**2)**2) + 1/5 + 4/(5*(x**2 + y**2))",
      "c": "-8.0/5.0*pow(x, 2)/pow(pow(x, 2) + pow(y, 2), 2) + 1.0/5.0 + (4.0/5.0)/(pow(x, 2) + pow(y, 2))",
      "numpy": "-8/5*x**2/(x**2 + y**2)**2 + 1/5 + (4/5)/(x**2 + y**2)"
     },
     {
      "sympy": "-8*x*y/(5*(x**2 + y**2)**2)",
      "c": "-8.0/5.0*x*y/pow(pow(x, 2) + pow(y, 2), 2)",
      "numpy": "-8/5*x*y/(x**2 + y**2)**2"
     }
    ]
   ]
  }
 },
 "boundaries": [
