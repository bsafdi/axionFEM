   "bc": "dirichlet",
   "normal": [
    {
     "sympy": "-x",
     "c": "-x",
     "numpy": "-x"
    },
    {
     "sympy": "-y",
     "c": "-y",
     "numpy": "-y"
    }
   ],
   "notes": "",
