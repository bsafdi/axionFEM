{
 "name": "annulus_sym",
 "description": "Curved free-slip wall: annulus 1<r<2, inner cylinder rotating at Omega=1, outer free slip. The two forms have DIFFERENT exact solutions (sym: rigid rotation; lap: A r + B/r). Needs isoparametric P2 geometry (Babuska-paradox control).",
 "domain": {
  "kind": "annulus",
  "r": [
   1,
   2
  ]
 },
 "pressure": "mean_zero",
 "conventions": {
  "G_ij": "d u_i / d x_j",
  "sigma_sym": "2 mu eps(u) - p I",
  "sigma_lap": "mu G - p I",
  "f": "-div sigma_form - gamma grad div u (= -div sigma_form for these fields)",
  "traction": "g = sigma_form n, n the outward unit normal",
  "grad_div": "gamma (div u_h, div v); gamma in viscosity units, not scaled by mu"
 },
 "u": [
  {
   "sympy": "-y",
   "c": "-y",
   "numpy": "-y"
  },
