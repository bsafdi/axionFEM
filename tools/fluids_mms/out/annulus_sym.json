     }
    ]
   ]
  }
 },
 "boundaries": [
  {
   "name": "r1",
   "bc": "dirichlet",
   "normal": [
    {
     "sympy": "-x",
     "c": "-x",
     "numpy": "-x"
    },
    {
     "sympy": "-y",
     "c": "-y",
     "numpy": "-y"
    }
   ],
   "notes": "",
   "param": {
    "x": {
     "sympy": "cos(t)",
     "c": "cos(t)",
     "numpy": "np.cos(t)"
    },
    "y": {
     "sympy": "sin(t)",
     "c": "sin(t)",
     "numpy": "np.sin(t)"
    },
    "range": [
     0,
     "2*pi"
    ]
   }
  },
  {
   "name": "r2",
   "bc": "slip",
   "normal": [
    {
     "sympy": "x/2",
     "c": "(1.0/2.0)*x",
