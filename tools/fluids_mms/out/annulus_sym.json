  "sympy": "0",
  "c": "0",
  "numpy": "0"
 },
 "mu": {
  "sympy": "1",
  "c": "1",
  "numpy": "1"
 },
 "grad_u": [
  [
   {
    "sympy": "0",
    "c": "0",
    "numpy": "0"
   },
   {
    "sympy": "-1",
    "c": "-1",
    "numpy": "-1"
   }
  ],
  [
   {
    "sympy": "1",
    "c": "1",
    "numpy": "1"
   },
   {
    "sympy": "0",
    "c": "0",
